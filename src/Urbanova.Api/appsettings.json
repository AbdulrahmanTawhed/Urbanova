{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Phase 2: SQL Server. Override via env var ConnectionStrings__UrbanovaDb or user-secrets.
    // Example: "Server=(localdb)\\mssqllocaldb;Database=Urbanova;Trusted_Connection=True;TrustServerCertificate=True"
    "UrbanovaDb": ""
  },
  "Jwt": {
    // Phase 3: ASP.NET Identity + JWT Bearer. No auth enforced in Phase 1 by design.
    "Issuer": "urbanova",
    "Audience": "urbanova-api",
    "Key": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "FileStorage": {
    // Phase 5: local disk MVP behind IFileStorage abstraction (future: blob swap).
    "RootPath": "AppData/uploads",
    "MaxBytes": 52428800,
    "AllowedContentTypes": [ "application/geo+json", "application/json" ]
  },
  "HeatAnalysis": {
    // TEMPORARY MVP DEFAULTS — pending engineering validation. See docs/assumptions.md.
    // Must stay configurable via IOptions; never hard-code in engines.
    "Metric": "LandSurfaceTempProxy",
    "Unit": "Celsius",
    "Method": "v0.1-weighted-area",
    "MethodVersion": "0.1.0-mvp",
    "ConfigVersion": "mvp-001",
    "BaseTemperatureC": 32.0,
    "VegCoolingPerPct": 0.05,
    "ShadingCoolingPerPct": 0.03,
    "AlbedoReference": 0.3,
    "AlbedoSensitivity": 8.0,
    "DefaultVegetationCoverPct": 0.0,
    "DefaultAlbedo": 0.3,
    "DefaultShadingPct": 0.0
  },
  "Classification": {
    // TEMPORARY thresholds — pending engineering validation. See docs/assumptions.md.
    "AcceptableBelow": 30.0,
    "ModerateBelow": 35.0
  },
  "ScenarioParameters": {
    // PRD v0.2 §7–§9: approved MVP parameters are configured here, not in code.
    // Keys stay camelCase (existing stored data + engine inputs); PRD snake_case
    // names are documented aliases in docs/assumptions.md. All values below are
    // TEMPORARY MVP DEFAULTS pending engineering validation.
    "MaxParameters": 3,
    "Parameters": [
      { "Key": "vegetationCoverPct", "Name": "Vegetation cover", "Unit": "%", "Min": 0, "Max": 100, "Allowed": true },
      { "Key": "albedo", "Name": "Surface albedo", "Unit": "fraction", "Min": 0, "Max": 1, "Allowed": true },
      { "Key": "shadingPct", "Name": "Shading", "Unit": "%", "Min": 0, "Max": 100, "Allowed": true }
    ]
  },
  "PriceCatalog": {
    // Phase 11: MVP file-backed catalog. Missing price -> CostStatus.Unavailable, never invented.
    "Path": "AppData/pricing/mvp-prices.json",
    "Currency": "USD"
  },
  "Reporting": {
    // Phase 12: JSON canonical + HTML renderer. PDF deferred (see ADR-004 placeholder).
    "DefaultFormat": "Json",
    "OutputPath": "AppData/reports"
  }
}
